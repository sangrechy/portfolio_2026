rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Production Security Rules: Deny all direct client access.
    // Public web/mobile clients cannot read or write any documents directly.
    // All activity is recorded exclusively server-side via the FastAPI Firebase Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
